# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# openssl rand -base64 32
AUTH_SECRET=

AUTH_URL=http://localhost:3000

# MongoDB. The database is created on first save.
# Whitelisted emails live in config/allowed-emails.txt (one address per line).
MONGODB_URI=
MONGODB_DB=agreement_portal
